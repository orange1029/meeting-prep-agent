# 环境变量与密钥 —— 绝不提交
.env
.github_token

# 长期记忆库 —— 含个人信息（姓名/邮箱/偏好），绝不提交
memory/
*.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境
# 注意：git 的 .gitignore 不支持行尾注释。
# 写成 ".venv-agents/   # 说明" 会让整行（含 # 和空格）都变成 pattern 而失效，
# 结果 .venv-agents/ 反而没被忽略。注释必须单独占一行。
.venv/
venv/
.venv-agents/

# IDE
.idea/
.vscode/

# 数据与输出
*.csv
*.parquet
.ipynb_checkpoints/

# 评估运行结果（每次跑都变，不入库）
eval_result.json

# trace 运行产物
trace_*.jsonl

# 简报输出（本地保留，不入库）
briefings/

# README 渲染验证页（临时产物，不入库）
README_render_check.html